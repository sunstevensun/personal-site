---
import Base from './Base.astro';
const { frontmatter } = Astro.props;

const date = new Date(frontmatter.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Base title={`${frontmatter.title} — Your Name`} description={frontmatter.gloss}>
  <p class="essay__meta">{date}</p>
  <h1 class="essay__title">{frontmatter.title}</h1>
  <div class="prose">
    <slot />
  </div>
</Base>
